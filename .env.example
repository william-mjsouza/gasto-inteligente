# Copie para .env (ignorado pelo Git) e preencha. Nunca coloque credenciais reais no repositório.
# O mesmo .env é lido pelo Docker Compose e pelo backend executado a partir de backend/.

# --- PostgreSQL ---
POSTGRES_DB=gasto_inteligente
POSTGRES_USER=gasto
# Obrigatório. Gere uma senha local, por exemplo: openssl rand -base64 24
POSTGRES_PASSWORD=
# Porta publicada em 127.0.0.1 pelo Compose.
POSTGRES_PORT=5432

# --- Backend executado fora do Docker (./mvnw spring-boot:run) ---
DB_HOST=localhost
# Deve coincidir com POSTGRES_PORT (ou a porta do seu PostgreSQL próprio).
DB_PORT=5432
# Opcional: use um PostgreSQL próprio em vez do banco do Compose. Se vazios, valem os POSTGRES_*.
# Use a mesma versão principal dos testes (18) e, de preferência, um usuário sem superusuário.
# DB_NAME=gasto_inteligente
# DB_USERNAME=
# DB_PASSWORD=

# --- Aplicação ---
APP_PORT=8080
# Em produção (HTTPS), mantenha true. Em http://localhost pode ser false.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m
